# ---- Backend (read by backend/app/config.py) ----
# SQLite database file (created automatically)
AEROSIM_DB_PATH=backend/aerosim.db
# Deterministic seed for the demonstration scenario and synthetic observations
AEROSIM_DEMO_SEED=42
# Default Monte Carlo sample count
AEROSIM_MC_SAMPLES=300
# Allowed browser origins (comma separated)
AEROSIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (Vite, read at build/dev time) ----
# Base URL of the API as seen from the browser; default "/api" uses the Vite dev proxy
VITE_API_BASE=/api
# Where the Vite dev server proxies /api to
VITE_API_PROXY=http://127.0.0.1:8000
